# Copiar a .env y completar. NUNCA subir el .env al repositorio.

# memoria | postgres
DATA_SOURCE=memoria

# Sólo si DATA_SOURCE=postgres
# IaaS (PostgreSQL dentro de la VM):
#   postgresql://turnero:clave@localhost:5432/turnero
# Contenedores (servicio del compose):
#   postgresql://turnero:clave@db:5432/turnero
# PaaS (Neon): copiar la cadena del panel, incluye ?sslmode=require
DATABASE_URL=

# true para bases administradas (Neon, Supabase). false para PostgreSQL local o en contenedor.
PGSSL=false

PORT=3000
HOST=0.0.0.0

# Se muestra en /api/info. Valores: iaas | paas | contenedores | faas
SERVICE_MODEL=local
INSTANCE_NAME=
REGION=
GRUPO=
APP_VERSION=1.0.0
LOG_PETICIONES=true
